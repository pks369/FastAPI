# Database & Broker
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/app
REDIS_URL=redis://redis:6379/0

# Concurrency & HTTP
WORKER_MAX_THREADS=20
GLOBAL_RPS=5
PROVIDER_RPS_JSONPLACEHOLDER=2
PROVIDER_RPS_DUMMYJSON=2
PROVIDER_RPS_REQRES=2
HTTP_TIMEOUT_SECONDS=10

# Celery job retry
JOB_RETRY_MAX=3
JOB_RETRY_BACKOFF_SECONDS=5

